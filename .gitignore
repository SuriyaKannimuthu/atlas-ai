# =========================================================================================
# Atlas AI - repository-wide ignore rules (backend/ Python, frontend/ Next.js, docs/)
# frontend/.gitignore adds Next.js-specific rules on top of these.
# =========================================================================================

# --- Secrets and local configuration ----------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
secrets/

# --- Python -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.python-version
*.egg-info/
*.egg
.eggs/
build/
dist/
pip-wheel-metadata/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.ipynb_checkpoints/

# --- Local runtime state (SQLite app DB and LangGraph checkpoints) ------------------------
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# --- Evaluation and test output ---------------------------------------------------------
evaluation-results/
backend/evaluation.json
test-results/
playwright-report/

# --- Node / Next.js ---------------------------------------------------------------------
node_modules/
.next/
out/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
coverage/

# --- Logs ---------------------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Docker -------------------------------------------------------------------------------
docker-compose.override.yml
.docker/

# --- Editors and OS -----------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Scratch ------------------------------------------------------------------------------
tmp/
*.tmp
*.bak
