# Atlas AI backend configuration. Copy to `.env` and adjust. Never commit real secrets.

APP_ENV=development
LOG_LEVEL=INFO

# --- Persistence -------------------------------------------------------------------------
# Application data (incidents, events, approvals, audit). SQLite by default; Postgres in Compose.
DATABASE_URL=sqlite:///./atlas.db
# DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas

# Workflow checkpoints (what makes investigations resumable): memory | sqlite | postgres
CHECKPOINTER=sqlite
CHECKPOINT_URL=./atlas_checkpoints.db
# CHECKPOINTER=postgres
# CHECKPOINT_URL=postgresql://atlas:atlas@localhost:5432/atlas

# Optional: shared rate limiting across instances
# REDIS_URL=redis://localhost:6379/0

# --- Security ----------------------------------------------------------------------------
# JSON map of API key -> principal. Roles: viewer | operator | approver | admin.
# When empty and APP_ENV=development, the key "atlas-dev-key" grants admin (logged as a warning).
# Production refuses to start without API_KEYS.
API_KEYS=
# API_KEYS={"replace-me-operator":{"subject":"oncall-bot","role":"operator"},"replace-me-approver":{"subject":"sre-lead","role":"approver"}}
CORS_ORIGINS=http://localhost:3000
REQUIRE_SEPARATION_OF_DUTIES=false
RATE_LIMIT_PER_MINUTE=20

# --- Model gateway -----------------------------------------------------------------------
# Leave empty to run fully offline with deterministic agents (no LLM calls, no cost).
# Any LangChain `init_chat_model` provider works once its integration package is installed,
# e.g. `pip install -e ".[anthropic]"` with:
# MODEL_PROVIDER=anthropic
# MODEL_NAME=claude-sonnet-5-5
# ANTHROPIC_API_KEY=
MODEL_PROVIDER=
MODEL_NAME=
MODEL_TIMEOUT_S=60
MODEL_MAX_RETRIES=2

# --- Workflow budgets --------------------------------------------------------------------
MAX_INVESTIGATION_ROUNDS=2
MAX_TOOL_CALLS=40
MAX_WORKFLOW_SECONDS=600
TOOL_TIMEOUT_S=10
TOOL_MAX_RETRIES=3
SUFFICIENT_CONFIDENCE=0.7
EXECUTOR=thread
WORKER_THREADS=4

# --- Observability -----------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=atlas-ai
